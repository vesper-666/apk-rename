# 复制为 .env 后按需修改。
# 后端不自动读取 .env，请用 `set -a; source .env; set +a` 或容器 -e / --env-file 传入。

PORT=8788
MAX_BODY_MB=400
MAX_CONCURRENT=2
UPLOAD_TTL=900
CMD_TIMEOUT=600

APK_TOOLS_DIR=./tools
APK_UBER_SIGNER=./tools/uber-apk-signer.jar

# 证书与密码均由程序在首次启动时生成，不要把任何 keystore 放进仓库
APK_KEYSTORE=./tools/release.keystore
APK_KEYSTORE_PASS=
APK_KEYSTORE_PASS_FILE=./tools/.keystore_pass
APK_KEYSTORE_ALIAS=apkrename

# 公网部署务必改成自己的前端域名，例如 https://apk.example.com
APK_CORS_ORIGIN=*
